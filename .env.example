# Copy this file to .env and fill in your values.

# Port the graphics server listens on
PORT=3000

# PIN required for the control dock, setup screen and HTTP control API.
# Choose your own 4-8 digit PIN. (Never commit .env.)
CONTROL_PIN=

# obs-websocket (OBS > Tools > WebSocket Server Settings)
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# Stream Deck / Companion HTTP endpoints (/api/goal/home, /api/replay/now, ...). Off unless set to on.
STREAM_DECK_API=off

# Remote access through a Cloudflare Tunnel (optional; see README "Remote access").
# Paste the tunnel token from the Cloudflare dashboard. The server then starts cloudflared by itself.
CLOUDFLARE_TUNNEL_TOKEN=
# The address you gave the tunnel, e.g. https://scores.yourdomain.com (shown in the server window and pre-match check)
PUBLIC_URL=
